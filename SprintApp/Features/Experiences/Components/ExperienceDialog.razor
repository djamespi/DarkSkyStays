@inject IJSRuntime JS
@inject SavedTripsService SavedTrips
@inject DemoBookingService Bookings
@implements IAsyncDisposable

<dialog @ref="dialog" class="experience-dialog" aria-labelledby="experience-dialog-title">
    @if (Experience is not null)
    {
        <button type="button" class="experience-close" data-dialog-close aria-label="Close experience details" @onclick="Dismiss"><Icon Name="close" Size="21" /></button>
        @if (step == DialogStep.Details)
        {
            <div class="experience-dialog-image"><img src="@Experience.ImageUrl" alt="An illustrated night sky in @Experience.Destination.Region" /><span><Icon Name="compass" Size="15" /> GOOD COMPANY. GREAT SKIES.</span></div>
            <div class="experience-dialog-content">
                <span class="eyebrow"><Icon Name="pin" Size="13" /> @Experience.Destination.DisplayName</span>
                <h2 id="experience-dialog-title">@Experience.Name</h2>
                <div class="experience-detail-facts"><span><Icon Name="clock" Size="14" /> @Experience.DurationHours.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) hours</span><span><Icon Name="people" Size="14" /> Up to @Experience.MaxParticipants guests</span><span><Icon Name="star" Size="13" /> @Experience.Rating.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) sample rating</span></div>
                <p class="experience-detail-description">@Experience.Description</p>
                <div class="experience-detail-columns"><div><h3>A few good things, included.</h3><ul class="experience-inclusions">@foreach (var item in Experience.Includes) { <li><Icon Name="check" Size="14" /> @item</li> }</ul><div class="guide-introduction"><span class="guide-avatar">@Experience.GuideName[..1]</span><span>Meet @Experience.GuideName<small>Your sample local sky guide</small></span></div></div><div class="experience-sky"><span class="eyebrow"><Icon Name="moon" Size="14" /> A GLIMPSE OF THE SKY</span><dl><div><dt>Light pollution</dt><dd>Bortle @Experience.Sky.BortleClass / 9</dd></div><div><dt>Moon phase</dt><dd>@Experience.Sky.MoonPhaseLabel</dd></div><div><dt>Moon illumination</dt><dd>@Experience.Sky.MoonIlluminationPercent%</dd></div><div><dt>Cloud cover</dt><dd>@Experience.Sky.CloudCoverPercent%</dd></div><div><dt>Sample window</dt><dd>@Experience.Sky.ViewingWindow</dd></div></dl><p>Sample conditions, not a live forecast.</p></div></div>
                <div class="experience-dialog-actions"><div class="experience-detail-price"><strong>$@Experience.PricePerPerson.ToString("0")</strong><span> USD / person</span><small>Sample rate · no payment required</small></div><button type="button" class="experience-save-detail @(IsSaved ? "selected" : "")" aria-label="@(IsSaved ? "Unsave this experience" : "Save this experience")" aria-pressed="@IsSaved.ToString().ToLowerInvariant()" @onclick="ToggleSaved"><Icon Name="heart" Size="19" /></button><button type="button" class="button button-lime plan-night" @onclick="StartBooking">Plan this night <Icon Name="arrow-right" Size="17" /></button></div>
            </div>
        }
        else if (step == DialogStep.Booking)
        {
            <div class="experience-dialog-content booking-content">
                <button type="button" class="booking-back" @onclick="ShowDetails"><Icon Name="arrow-left" Size="14" /> Back to the experience</button>
                <span class="eyebrow">A LITTLE SOMETHING TO LOOK FORWARD TO</span>
                <h2 id="experience-dialog-title" tabindex="-1" data-step-title>Make room for <em>wonder.</em></h2>
                <div class="booking-tour-summary"><img src="@Experience.ImageUrl" alt="" /><div><strong>@Experience.Name</strong><span>@Experience.Destination.DisplayName</span><small>@Experience.DurationHours.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) hours · Guided by @Experience.GuideName</small></div></div>
                <div class="demo-booking-note"><Icon Name="sparkles" Size="17" /><p>A little rehearsal for a real adventure. This is a <strong>demo booking</strong>; no reservation, payment, or email will be made.</p></div>
                <EditForm EditContext="bookingContext" OnSubmit="SubmitBooking" FormName="experience-demo-booking" novalidate>
                    @if (bookingContext.GetValidationMessages().Any()) { <div class="booking-errors" role="alert" data-validation-errors tabindex="-1"><strong>A few little details need your attention.</strong><ValidationSummary /></div> }
                    <div class="booking-fields">
                        <div class="booking-field"><label for="booking-name">Your name</label><InputText id="booking-name" @bind-Value="request.Name" autocomplete="name" maxlength="80" placeholder="What should we call you?" aria-describedby="booking-name-error" /><div id="booking-name-error"><ValidationMessage For="() => request.Name" /></div></div>
                        <div class="booking-field"><label for="booking-email">Email address</label><InputText id="booking-email" type="email" @bind-Value="request.Email" autocomplete="email" maxlength="120" placeholder="you@example.com" aria-describedby="booking-email-error" /><div id="booking-email-error"><ValidationMessage For="() => request.Email" /></div></div>
                        <div class="booking-field"><label for="booking-night">Choose your sample night</label><InputDate id="booking-night" @bind-Value="request.Night" min="@Bookings.Today.ToString("yyyy-MM-dd")" max="@Bookings.LastBookableNight.ToString("yyyy-MM-dd")" aria-describedby="booking-night-error" /><div id="booking-night-error"><ValidationMessage For="() => request.Night" /></div></div>
                        <div class="booking-field"><label for="booking-guests">Who's coming along?</label><InputSelect id="booking-guests" @bind-Value="request.Guests" aria-describedby="booking-guests-error">@for (var guests = 1; guests <= Experience.MaxParticipants; guests++) { <option value="@guests">@guests guest@(guests == 1 ? "" : "s")</option> }</InputSelect><div id="booking-guests-error"><ValidationMessage For="() => request.Guests" /></div></div>
                    </div>
                    <div class="booking-total"><div><span>$@Experience.PricePerPerson.ToString("0") × @request.Guests guest@(request.Guests == 1 ? "" : "s")</span><span>$@Total.ToString("0")</span></div><div><strong>Sample total</strong><strong id="booking-total">$@Total.ToString("0") <small>USD</small></strong></div><p>No charge. All dates and availability are for demonstration.</p></div>
                    <button type="submit" class="button button-lime booking-submit">Confirm demo booking <Icon Name="arrow-right" Size="17" /></button>
                </EditForm>
            </div>
        }
        else if (confirmation is not null)
        {
            <div class="experience-dialog-content confirmation-content">
                <span class="confirmation-mark"><Icon Name="check" Size="29" /></span><span class="eyebrow">A LITTLE WONDER, ON THE HORIZON</span><h2 id="experience-dialog-title" tabindex="-1" data-step-title>Your sample night<br /><em>is planned.</em></h2><p>Something to look forward to, @confirmation.GuestName.</p>
                <div class="confirmation-reference"><span>DEMO CONFIRMATION</span><strong>@confirmation.Reference</strong></div>
                <h3>@confirmation.ExperienceName</h3><p class="confirmation-place">@confirmation.Destination</p>
                <dl class="confirmation-facts"><div><dt>Your sample night</dt><dd>@confirmation.Night.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</dd></div><div><dt>Your people</dt><dd>@confirmation.Guests guest@(confirmation.Guests == 1 ? "" : "s")</dd></div><div><dt>Sample email</dt><dd>@confirmation.Email</dd></div><div><dt>Sample total</dt><dd>$@confirmation.Total.ToString("0") USD</dd></div></dl>
                <div class="demo-booking-note"><Icon Name="moon" Size="18" /><p>This is a demo confirmation. <strong>No real reservation was made, no payment was taken, and no email was sent.</strong> It lasts for this visit.</p></div>
                <div class="confirmation-actions"><button type="button" class="button button-outline" aria-pressed="@IsSaved.ToString().ToLowerInvariant()" @onclick="ToggleSaved"><Icon Name="heart" Size="16" /> @(IsSaved ? "Remove from saved" : "Save this experience")</button><button type="button" class="button button-lime" @onclick="Dismiss">Keep exploring <Icon Name="arrow-up-right" Size="16" /></button></div>
            </div>
        }
    }
</dialog>

@code {
    [Parameter] public TourExperience? Experience { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnSaved { get; set; }

    private enum DialogStep { Details, Booking, Confirmation }
    private DialogStep step;
    private string? currentExperienceId;
    private DemoBookingRequest request = new();
    private DemoBookingConfirmation? confirmation;
    private EditContext bookingContext = default!;
    private ValidationMessageStore? validationMessages;
    private ElementReference dialog;
    private IJSObjectReference? module;
    private DotNetObjectReference<ExperienceDialog>? reference;
    private bool isOpen;
    private bool needsStepFocus;
    private bool needsErrorFocus;
    private bool IsSaved => Experience is not null && SavedTrips.Contains(Experience.Id, SavedItemType.Experience);
    private decimal Total => (Experience?.PricePerPerson ?? 0m) * request.Guests;

    protected override void OnParametersSet()
    {
        if (currentExperienceId == Experience?.Id) return;
        currentExperienceId = Experience?.Id;
        step = DialogStep.Details;
        confirmation = null;
        needsStepFocus = false;
        needsErrorFocus = false;
    }

    private void StartBooking()
    {
        if (bookingContext is not null) bookingContext.OnFieldChanged -= ClearFieldError;
        request = new DemoBookingRequest();
        bookingContext = new EditContext(request);
        validationMessages = new ValidationMessageStore(bookingContext);
        bookingContext.OnFieldChanged += ClearFieldError;
        step = DialogStep.Booking;
        needsStepFocus = true;
    }

    private void ClearFieldError(object? sender, FieldChangedEventArgs args)
    {
        validationMessages?.Clear(args.FieldIdentifier);
        bookingContext.NotifyValidationStateChanged();
    }

    private void SubmitBooking()
    {
        if (Experience is null || confirmation is not null) return;
        validationMessages!.Clear();
        bookingContext.NotifyValidationStateChanged();
        // InputDate's own parsing errors must also block submission.
        if (!bookingContext.Validate()) { needsErrorFocus = true; return; }
        if (!Bookings.TryCreate(Experience.Id, request, out var result, out var errors))
        {
            foreach (var error in errors) validationMessages.Add(bookingContext.Field(error.Key), error.Value);
            bookingContext.NotifyValidationStateChanged();
            needsErrorFocus = true;
            return;
        }
        confirmation = result;
        step = DialogStep.Confirmation;
        needsStepFocus = true;
    }

    private void ShowDetails() { step = DialogStep.Details; needsStepFocus = true; }
    [JSInvokable] public Task Dismiss() => OnClose.InvokeAsync();
    private async Task ToggleSaved()
    {
        if (Experience is null) return;
        var added = SavedTrips.Toggle(Experience.Id, SavedItemType.Experience);
        await OnSaved.InvokeAsync(added ? $"{Experience.Name} saved for this visit." : $"{Experience.Name} removed from saved experiences.");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
            reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("attach", dialog, reference);
        }
        if (module is null) return;
        if (isOpen != (Experience is not null))
        {
            isOpen = Experience is not null;
            await module.InvokeVoidAsync(isOpen ? "open" : "close", dialog);
        }
        if (isOpen && needsStepFocus)
        {
            needsStepFocus = false;
            await module.InvokeVoidAsync("focusStep", dialog);
        }
        if (isOpen && needsErrorFocus)
        {
            needsErrorFocus = false;
            await module.InvokeVoidAsync("focusErrors", dialog);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (bookingContext is not null) bookingContext.OnFieldChanged -= ClearFieldError;
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("detach", dialog); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        reference?.Dispose();
    }
}
