@page "/saved-trips"
@inject SavedTripsService Saved
@inject DemoBookingService Bookings
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Your collection — Dark Sky Stays</PageTitle>

<section class="saved-intro"><div class="page-width saved-intro-inner"><div><a class="saved-back" href="/"><Icon Name="arrow-left" Size="14" /> Back to discovering</a><span class="eyebrow">THE START OF SOMETHING WONDERFUL</span><h1>A little collection.<br /><em>A world of possibility.</em></h1><p>The places you love. The nights you’re imagining.<br />Keep them close while you find your next escape.</p></div><div class="collection-constellation" aria-hidden="true"><span class="constellation-orbit orbit-a"></span><span class="constellation-orbit orbit-b"></span><span class="constellation-orbit orbit-c"></span><span class="constellation-moon"><Icon Name="moon" Size="58" /></span><span class="constellation-star star-a">✦</span><span class="constellation-star star-b">✧</span><span class="constellation-star star-c">✧</span><span class="constellation-caption">GOOD THINGS ARE ON THE HORIZON</span></div></div></section>

<section class="page-width saved-layout" aria-label="Your saved trips">
    <aside class="collection-summary"><span class="eyebrow">YOUR LITTLE ESCAPE</span><h2>Made of <br /><em>good possibilities.</em></h2><dl><div><dt><Icon Name="cabin" Size="16" /> Saved stays</dt><dd>@Saved.StayCount</dd></div><div><dt><Icon Name="telescope" Size="16" /> Experiences</dt><dd>@Saved.ExperienceCount</dd></div><div><dt><Icon Name="calendar" Size="16" /> Demo bookings</dt><dd>@Bookings.Confirmations.Count</dd></div><div><dt><Icon Name="pin" Size="16" /> Destinations</dt><dd>@DestinationCount</dd></div></dl><button type="button" class="button button-primary download-collection" disabled="@(!HasCollection || exporting)" @onclick="DownloadCollection"><Icon Name="download" Size="16" /> @(exporting ? "Getting it ready…" : "Download collection")</button><p class="summary-note">A text snapshot to keep for later. Saved items and demo bookings reset when you refresh.</p><div class="collection-summary-footer"><Icon Name="sparkles" Size="21" /><p>Sometimes a little daydream<br />is how a great night begins.</p></div></aside>

    <div class="saved-main">
        <div class="saved-type-tabs" role="group" aria-label="Collection filter">
            @foreach (var option in new[] { ("all", "Everything", Saved.Count + Bookings.Confirmations.Count), ("stays", "Stays", Saved.StayCount), ("experiences", "Experiences", Saved.ExperienceCount), ("bookings", "Demo bookings", Bookings.Confirmations.Count) })
            {
                <button type="button" data-collection-view="@option.Item1" class="@(view == option.Item1 ? "selected" : "")" aria-pressed="@((view == option.Item1).ToString().ToLowerInvariant())" @onclick="() => ShowView(option.Item1)">@option.Item2 <span>@option.Item3</span></button>
            }
        </div>
        <div class="saved-toolbar"><p role="status" id="collection-count">@VisibleCount @(VisibleCount == 1 ? "possibility" : "possibilities") in this view</p>@if (Saved.Count > 0) { <button type="button" class="clear-collection" @onclick="ClearFavorites">Clear saved favorites <Icon Name="close" Size="13" /></button> }</div>

        @if (VisibleCount == 0)
        {
            <div class="saved-empty"><span class="empty-moon"><Icon Name="@(view == "bookings" ? "calendar" : "heart")" Size="32" /></span><span class="eyebrow">LEAVE A LITTLE ROOM FOR WONDER</span><h2>@(view == "bookings" ? "A good night starts with a little plan." : "Every adventure starts with a little daydream.")</h2><p>@(view == "bookings" ? "Explore an experience and choose Plan this night to try a demo booking. Your sample confirmation will be waiting here." : "Tap the heart on a stay or experience that speaks to you. We’ll keep your favorites together for this visit.")</p><div><a class="button button-primary" href="@(view == "bookings" || view == "experiences" ? "/experiences" : "/stays")">@(view == "bookings" || view == "experiences" ? "Explore after dark" : "Find your somewhere") <Icon Name="arrow-up-right" Size="16" /></a>@if (view == "all") { <a class="text-link" href="/experiences">Discover experiences <Icon Name="arrow-right" Size="16" /></a> }</div></div>
        }
        else
        {
            @if (ShowStays && SavedStays.Count > 0)
            {
                <section class="saved-section" aria-labelledby="saved-stays-heading"><div class="saved-section-heading"><div><span class="eyebrow">SOMEWHERE TO SLOW DOWN</span><h2 id="saved-stays-heading">Stays you’re dreaming of.</h2></div><a href="/stays" class="text-link">Find a few more <Icon Name="arrow-up-right" Size="15" /></a></div><div class="saved-stay-grid grid grid-cols-1 gap-6 md:grid-cols-2">@foreach (var stay in SavedStays) { <StayCard @key="stay.Id" Stay="stay" OnDetails="OpenStay" OnSaved="Announce" /> }</div></section>
            }
            @if (ShowExperiences && SavedExperiences.Count > 0)
            {
                <section class="saved-section" aria-labelledby="saved-experiences-heading"><div class="saved-section-heading"><div><span class="eyebrow">A LITTLE AFTER-DARK MAGIC</span><h2 id="saved-experiences-heading">Nights on your wish list.</h2></div><a href="/experiences" class="text-link">Stay curious <Icon Name="arrow-up-right" Size="15" /></a></div><div class="saved-experience-grid grid grid-cols-1 gap-6 md:grid-cols-2">@foreach (var experience in SavedExperiences) { <ExperienceCard @key="experience.Id" Experience="experience" OnDetails="OpenExperience" OnSaved="Announce" /> }</div></section>
            }
            @if (ShowBookings && Bookings.Confirmations.Count > 0)
            {
                <section class="saved-section" aria-labelledby="saved-bookings-heading"><div class="saved-section-heading"><div><span class="eyebrow">A LITTLE SOMETHING TO LOOK FORWARD TO</span><h2 id="saved-bookings-heading">Your sample nights.</h2></div><span class="sample-bookings-label">Demo only · no reservations</span></div><div class="booking-receipts">@foreach (var booking in Bookings.Confirmations.OrderBy(item => item.Night)) { <article class="booking-receipt" @key="booking.Reference" data-booking-reference="@booking.Reference"><div class="receipt-date"><span>@booking.Night.ToString("MMM", System.Globalization.CultureInfo.InvariantCulture)</span><strong>@booking.Night.Day</strong><small>@booking.Night.Year</small></div><div class="receipt-content"><div class="receipt-top"><span>DEMO BOOKING</span><span>@booking.Reference</span></div><h3>@booking.ExperienceName</h3><p><Icon Name="pin" Size="12" /> @booking.Destination</p><div class="receipt-facts"><span><Icon Name="people" Size="14" /> @booking.Guests guest@(booking.Guests == 1 ? "" : "s")</span><span><strong>$@booking.Total.ToString("0") USD</strong> sample total</span></div><details class="receipt-guest"><summary>Guest details</summary><p>@booking.GuestName<br />@booking.Email</p></details><div class="receipt-actions"><button type="button" @onclick="() => ViewBookedExperience(booking.ExperienceId)">View experience <Icon Name="arrow-up-right" Size="14" /></button><button type="button" class="remove-demo-booking" @onclick="() => RemoveBooking(booking.Reference)">Remove demo plan <Icon Name="close" Size="13" /></button></div><p class="receipt-demo-note">No real reservation, payment, or email was made.</p></div></article> }</div></section>
            }
        }
        <div class="collection-next-night"><Icon Name="compass" Size="23" /><div><h3>There’s a whole night out there.</h3><p>A place to stay. A story to come home with.</p></div><a href="/experiences">Find a little more wonder <Icon Name="arrow-right" Size="16" /></a></div>
    </div>
</section>

<StayDetailsDialog Stay="selectedStay" OnClose="() => selectedStay = null" OnSaved="Announce" />
<ExperienceDialog Experience="selectedExperience" OnClose="() => selectedExperience = null" OnSaved="Announce" />
<div class="save-notice @(message.Length == 0 ? "is-hidden" : "")" role="status" aria-live="polite"><Icon Name="heart" Size="17" /><span>@message</span>@if (clearBackup.Count > 0) { <button type="button" class="undo-clear" @onclick="UndoClear">Undo</button> }<button type="button" aria-label="Dismiss collection notification" @onclick="DismissNotice"><Icon Name="close" Size="15" /></button></div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    private string view = "all";
    private string message = "";
    private Stay? selectedStay;
    private TourExperience? selectedExperience;
    private IReadOnlyList<SavedTrip> clearBackup = [];
    private IJSObjectReference? exportModule;
    private bool exporting;
    private IReadOnlyList<Stay> SavedStays => Saved.Items.Where(item => item.ItemType == SavedItemType.Stay).OrderByDescending(item => item.SavedAt).Select(item => SampleStays.All.FirstOrDefault(stay => stay.Id == item.ItemId)).OfType<Stay>().ToArray();
    private IReadOnlyList<TourExperience> SavedExperiences => Saved.Items.Where(item => item.ItemType == SavedItemType.Experience).OrderByDescending(item => item.SavedAt).Select(item => SampleExperiences.All.FirstOrDefault(experience => experience.Id == item.ItemId)).OfType<TourExperience>().ToArray();
    private bool ShowStays => view is "all" or "stays";
    private bool ShowExperiences => view is "all" or "experiences";
    private bool ShowBookings => view is "all" or "bookings";
    private bool HasCollection => Saved.Count > 0 || Bookings.Confirmations.Count > 0;
    private int VisibleCount => (ShowStays ? SavedStays.Count : 0) + (ShowExperiences ? SavedExperiences.Count : 0) + (ShowBookings ? Bookings.Confirmations.Count : 0);
    private int DestinationCount => SavedStays.Select(stay => stay.Destination.DisplayName).Concat(SavedExperiences.Select(experience => experience.Destination.DisplayName)).Concat(Bookings.Confirmations.Select(booking => booking.Destination)).Distinct().Count();

    protected override void OnInitialized() { Saved.Changed += Refresh; Bookings.Changed += Refresh; }
    protected override void OnParametersSet() { view = ViewQuery is "stays" or "experiences" or "bookings" ? ViewQuery : "all"; selectedStay = null; selectedExperience = null; }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    private void ShowView(string next) => Navigation.NavigateTo(next == "all" ? "/saved-trips" : $"/saved-trips?view={next}");
    private void OpenStay(Stay stay) => selectedStay = stay;
    private void OpenExperience(TourExperience experience) => selectedExperience = experience;
    private void ViewBookedExperience(string id) => selectedExperience = SampleExperiences.All.FirstOrDefault(experience => experience.Id == id);
    private void Announce(string text) { clearBackup = []; message = text; }
    private void DismissNotice() { message = ""; clearBackup = []; }
    private void ClearFavorites() { clearBackup = Saved.Clear(); message = "Saved favorites cleared. Your demo bookings are still here."; }
    private void UndoClear() { Saved.Restore(clearBackup); clearBackup = []; message = "Your saved favorites are back."; }
    private void RemoveBooking(string reference) { Bookings.Remove(reference); Announce("Demo plan removed. No real reservation was affected."); }

    private async Task DownloadCollection()
    {
        if (!HasCollection || exporting) return;
        exporting = true;
        try
        {
            exportModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/trip-export.js");
            await exportModule.InvokeVoidAsync("downloadText", "dark-sky-stays-collection.txt", TripNotesBuilder.Build(Saved.Items, Bookings.Confirmations));
            Announce("Your collection is ready to download.");
        }
        catch (JSException) { Announce("The download could not start. Please try again."); }
        finally { exporting = false; }
    }

    public async ValueTask DisposeAsync()
    {
        Saved.Changed -= Refresh;
        Bookings.Changed -= Refresh;
        if (exportModule is not null) { try { await exportModule.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
