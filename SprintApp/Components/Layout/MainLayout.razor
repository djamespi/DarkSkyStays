@inherits LayoutComponentBase
@using SprintApp.Features.SavedTrips.Components
@using SprintApp.Features.Sky.Components
@using SprintApp.Features.Sky.Models
@using SprintApp.Features.Stays.Data

<a href="#main-content" class="skip-link">Skip to content</a>
<header class="site-header">
    <div class="page-width header-inner">
        <a class="brand" href="/" aria-label="Dark Sky Stays home">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>Dark Sky <em>Stays</em></span>
        </a>
        <NavMenu />
        <div class="header-actions">
            <div class="header-moon" aria-label="Sample moon conditions">
                <MoonPhaseIcon Phase="SampleSky.MoonPhase" IlluminationPercent="SampleSky.MoonIlluminationPercent" Size="32" />
                <span>@SampleSky.MoonPhaseLabel<small>@SampleSky.MoonIlluminationPercent% illuminated · sample</small></span>
            </div>
            <SavedMenu />
        </div>
    </div>
</header>

<main id="main-content" tabindex="-1">@Body</main>

<footer class="site-footer page-width">
    <div class="footer-top">
        <a href="/" class="footer-brand"><Icon Name="moon" Size="22" /> dark sky stays<span>Less light. More wonder.</span></a>
        <p>For the places that stay with you,<br />long after the sun comes up.</p>
        <a href="#main-content" class="back-top">Back to the stars <Icon Name="arrow-up-right" Size="16" /></a>
    </div>
    <div class="footer-bottom"><span>© 2026 Dark Sky Stays. Made for looking up.</span><span>Demo collection · Sample listings, prices &amp; sky conditions · Prices in USD</span></div>
</footer>

<div id="blazor-error-ui" role="alert">
    The connection to the stars was interrupted. <a href="" class="reload">Reload the page</a>
</div>

@code {
    private static SkyConditions SampleSky => SampleStays.All[0].Sky;
}
