        case "telescope":
            <path d="m3 9 13-6 3 6-13 6ZM14 12l5 9M12 13l-4 8M12 13v8M19 4l2-1 2 4-2 1" />
            break;
        case "calendar":
            <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4m10-4v4M3 11h18m-13 4h2m4 0h2" />
            break;
        case "download":
            <path d="M12 3v12m-5-5 5 5 5-5M4 15v6h16v-6" />
            break;
        default:
            <circle cx="12" cy="12" r="4" />
            break;
