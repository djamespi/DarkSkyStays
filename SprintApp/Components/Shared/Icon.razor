        case "sliders":
            <path d="M4 7h5m4 0h7M4 17h9m4 0h3" /><circle cx="11" cy="7" r="2" /><circle cx="15" cy="17" r="2" />
            break;
        case "cabin":
            <path d="m3 11 9-8 9 8M5 10v11h14V10M10 21v-7h4v7" />
            break;
        case "dome":
            <path d="M2 20h20M3 19a9 9 0 0 1 18 0M12 10v10M4 15h16m-14-3 6 8 6-8" />
            break;
        case "tent":
            <path d="m3 21 9-18 9 18ZM8 21l4-8 4 8M9 3l3 6 3-6" />
